{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["hinge"],
  "ios": {
    "iosModuleName": "Hinge",
    "iosCxxLibName": "Hinge"
  },
  "android": {
    "androidNamespace": ["hinge"],
    "androidCxxLibName": "Hinge"
  },
  "autolinking": {
    "Hinge": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridHinge"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridHinge"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/example/**"
  ]
}
